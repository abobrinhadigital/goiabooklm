<div class="container" style="max-width: 500px; margin-top: 5rem;">
  <div class="bookmark-card">
    <h2 style="margin-bottom: 2rem; text-align: center;">Criar conta</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field" style="width: 100%;">
        <%= f.label :email, "E-mail" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", style: "display: block; width: 100%;" %>
      </div>

      <div class="field" style="width: 100%;">
        <%= f.label :password, "Senha" %>
        <% if @minimum_password_length %>
          <em style="font-size: 0.8rem; color: #777;">(mínimo de <%= @minimum_password_length %> caracteres)</em>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "sua senha", style: "display: block; width: 100%;" %>
      </div>

      <div class="field" style="width: 100%;">
        <%= f.label :password_confirmation, "Confirmação de senha" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "confirme sua senha", style: "display: block; width: 100%;" %>
      </div>

      <div class="actions">
        <%= f.submit "Criar conta", class: "btn btn-primary", style: "width: 100%; padding: 1rem; font-size: 1.1rem;" %>
      </div>
    <% end %>

    <div style="margin-top: 1.5rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem; text-align: center; font-size: 0.95rem;">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
