<div class="container" style="max-width: 500px; margin-top: 5rem;">
  <div class="bookmark-card">
    <h2 style="margin-bottom: 2rem; text-align: center;">Entrar</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field" style="width: 100%;">
        <%= f.label :email, "E-mail" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", style: "display: block; width: 100%;" %>
      </div>

      <div class="field" style="width: 100%;">
        <%= f.label :password, "Senha" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "sua senha", style: "display: block; width: 100%;" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="custom-checkbox-container">
          <%= f.check_box :remember_me %>
          <span class="checkmark"></span>
          <span>Lembrar-me</span>
        </label>
      <% end %>

      <div class="actions">
        <%= f.submit "Entrar", class: "btn btn-primary", style: "width: 100%; padding: 1rem; font-size: 1.1rem;" %>
      </div>
    <% end %>

    <div style="margin-top: 1.5rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem; text-align: center; font-size: 0.95rem;">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
