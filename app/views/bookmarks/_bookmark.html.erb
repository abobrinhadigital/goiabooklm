<div id="<%= dom_id bookmark %>" class="bookmark-card">
  <h3 class="bookmark-title">
    <%= link_to bookmark.title.presence || bookmark.url, bookmark.url, target: "_blank", rel: "noopener" %>
  </h3>
  
  <div class="bookmark-url">
    <%= link_to URI.parse(bookmark.url).host || bookmark.url, bookmark.url, target: "_blank", rel: "noopener" %>
  </div>

  <div class="bookmark-meta">
    <span>Adicionado em <%= bookmark.created_at.strftime("%d/%m/%Y às %H:%M") %> | </span>
    <span class="status-indicator">
      <% if bookmark.status == 0 %>
        <i class="fa-solid fa-clock status-pending" title="Aguardando Processamento"></i>
      <% elsif bookmark.status == 3 %>
        <i class="fa-solid fa-hourglass-start status-pending" title="Reprocessando via Varinha"></i>
      <% elsif bookmark.status == 1 %>
        <i class="fa-solid fa-circle-check status-success" title="Esmiuçado"></i>
      <% else %>
        <i class="fa-solid fa-circle-exclamation status-error" title="IA Capotou"></i>
      <% end %>
    </span>
  </div>

  <% if bookmark.summary.present? %>
    <div class="bookmark-summary">
      <%= render_markdown(bookmark.summary) %>
    </div>
  <% elsif bookmark.description.present? && bookmark.status != 1 %>
    <div class="bookmark-summary bookmark-description-preview">
      <%= bookmark.description %>
    </div>
  <% end %>

  <div class="card-actions">
    <div class="action-group-left">
      <%= button_to bookmark_path(bookmark), method: :delete, data: { turbo_confirm: "Tem certeza que deseja deletar esta abobrinha?" }, class: "btn-icon btn-delete", title: "Apagar" do %>
        <i class="fa-solid fa-trash-can"></i>
      <% end %>
    </div>

    <div class="action-group-right">
      <%= button_to summarize_bookmark_path(bookmark), method: :post, class: "btn-icon btn-summarize", 
          title: bookmark.summary.present? ? "Refazer Resumo" : "Solicitar Resumo",
          data: { turbo_frame: "_top" } do %>
        <i class="fa-solid fa-wand-magic-sparkles"></i>
      <% end %>

      <%= button_to toggle_favorite_bookmark_path(bookmark), method: :patch, class: "btn-icon btn-favorite #{'active' if bookmark.favorite}", title: bookmark.favorite ? "Desfavoritar" : "Favoritar" do %>
        <i class="fa-<%= bookmark.favorite ? 'solid' : 'regular' %> fa-bookmark"></i>
      <% end %>

      <%= button_to toggle_read_bookmark_path(bookmark), method: :patch, class: "btn-icon btn-read #{'active' if bookmark.read}", title: bookmark.read ? "Desmarcar Leitura" : "Marcar como Lido" do %>
        <i class="fa-solid fa-check-circle"></i>
      <% end %>
    </div>
  </div>
</div>
