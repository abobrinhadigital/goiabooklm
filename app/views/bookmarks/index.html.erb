<% content_for :title, "Fazenda de Links - GoiabookLM" %>

<%= turbo_frame_tag "modal" %>

<div style="margin-bottom: 2rem;">
  <h3>Adicionar Nova Abobrinha</h3>
  <%= render 'form', bookmark: Bookmark.new %>
</div>

<div class="tabs" style="display: flex; gap: 1rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
  <%= link_to "Todos", bookmarks_path, class: "tab", style: "text-decoration: none; color: #{!params[:favorites] && !params[:unread] ? 'var(--text-color)' : '#aaa'}; font-weight: #{!params[:favorites] && !params[:unread] ? 'bold' : 'normal'}; #{!params[:favorites] && !params[:unread] ? 'border-bottom: 2px solid #eab308; padding-bottom: 0.5rem;' : 'padding-bottom: 0.5rem;'}" %>
  
  <%= link_to "Não Lidas", bookmarks_path(unread: 'true', query: params[:query]), class: "tab", style: "text-decoration: none; color: #{params[:unread] == 'true' ? 'var(--text-color)' : '#aaa'}; font-weight: #{params[:unread] == 'true' ? 'bold' : 'normal'}; #{params[:unread] == 'true' ? 'border-bottom: 2px solid #eab308; padding-bottom: 0.5rem;' : 'padding-bottom: 0.5rem;'}" %>

  <%= link_to "Favoritos", bookmarks_path(favorites: 'true', query: params[:query]), class: "tab", style: "text-decoration: none; color: #{params[:favorites] == 'true' ? 'var(--text-color)' : '#aaa'}; font-weight: #{params[:favorites] == 'true' ? 'bold' : 'normal'}; #{params[:favorites] == 'true' ? 'border-bottom: 2px solid #eab308; padding-bottom: 0.5rem;' : 'padding-bottom: 0.5rem;'}" %>
</div>

<div style="margin-bottom: 2rem; background-color: var(--card-bg); padding: 1rem; border-radius: 8px;">
  <%= form_with url: bookmarks_path, method: :get, local: true, class: "search-form", data: { turbo_frame: "_top" } do |f| %>
    <%= f.hidden_field :unread, value: params[:unread] if params[:unread] == 'true' %>
    <%= f.hidden_field :favorites, value: params[:favorites] if params[:favorites] == 'true' %>
    
    <div style="display: flex; gap: 10px; align-items: stretch; width: 100%;">
      <%= f.text_field :query, value: params[:query], placeholder: "Buscar nos devaneios da rede...", style: "flex-grow: 1; margin: 0; min-width: 0;" %>
      <%= f.submit "Buscar", class: "btn btn-primary", style: "margin: 0; flex-shrink: 0;" %>
      
      <% if params[:query].present? %>
        <%= link_to "Limpar", bookmarks_path(unread: params[:unread], favorites: params[:favorites]), class: "btn", style: "border: none; margin: 0; color: #aaa; flex-shrink: 0;" %>
      <% end %>
    </div>
  <% end %>
</div>

<div id="bookmarks" class="bookmarks-grid">
  <% @bookmarks.each do |bookmark| %>
    <%= render bookmark %>
  <% end %>
</div>

<% if @pagy.pages > 1 %>
  <div style="display: flex; justify-content: center; margin-top: 3rem; margin-bottom: 3rem;">
    <nav class="pagy-nav">
      <%== pagy_nav(@pagy) %>
    </nav>
  </div>
<% end %>
