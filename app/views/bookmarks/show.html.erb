<%= turbo_frame_tag "modal" do %>
  <div class="modal-backdrop">
    <div class="modal-box article-content">
      <div class="modal-header">
        <h2><%= @bookmark.title.presence || @bookmark.url %></h2>
        <%= link_to "✕", bookmarks_path, data: { turbo_frame: "_top" }, class: "btn", style: "border: none; color: #888; font-size: 1.5rem; padding: 0 0.5rem; margin-left: 1rem;" %>
      </div>
      <div class="modal-body">
        <% if @bookmark.content.present? %>
          <%= render_markdown(@bookmark.content) %>
        <% else %>
          <p style="text-align: center; color: #777; margin-top: 2rem;">
            O texto longo ainda não foi extraído do limbo da internet. O robô deve estar atrasado.
          </p>
        <% end %>
        
        <div class="card-actions" style="margin-top: 2rem; border-top: 1px solid #444; padding-top: 1rem; display: flex; gap: 1rem; align-items: center;">
          <%= button_to "Apagar Existência", @bookmark, method: :delete, data: { turbo_frame: "_top" }, class: "btn", style: "border-color: #d85a5a; color: #d85a5a; margin: 0;" %>
          <div style="flex-grow: 1;"></div>
          <%= button_to (@bookmark.read ? "Desmarcar Leitura" : "Marcar Lida"), toggle_read_bookmark_path(@bookmark), method: :patch, data: { turbo_frame: "_top" }, class: "btn #{@bookmark.read ? '' : 'btn-primary'}", style: "margin: 0;" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
