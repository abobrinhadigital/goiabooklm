#!/usr/bin/env ruby
require "fileutils"
require "socket"

APP_ROOT = File.expand_path("..", __dir__)

# Detecta se deve rodar em produção por padrão caso não especificado
if !ENV["RAILS_ENV"] && File.exist?("/etc/systemd/system/goiabooklm.service")
  ENV["RAILS_ENV"] = "production"
  puts "[i] Serviço detectado. Assumindo RAILS_ENV=production para segurança."
end

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Preparing database =="
  # db:prepare às vezes falha em migrar bancos particionados (Solid Queue) em setups manuais
  system! "bin/rails db:prepare"
  
  # Garantir migração de todos os contextos (produção/dev)
  ["primary", "queue", "cable", "cache"].each do |db|
    puts "--> Migrating #{db} database..."
    begin
      # Usamos db:migrate:status apenas para logar, o comando real é o migrate
      system "bin/rails db:migrate NAME=#{db}"
    rescue => e
      puts "[!] Pequeno percalço no banco #{db}: #{e.message}. Provavelmente índices já existentes. Seguindo viagem..."
    end
  end

  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Seeding/Syncing Rules =="
  # Sincroniza apenas se for a primeira vez (banco vazio) ou se for solicitado explicitamente
  should_sync = ARGV.include?("--sync") || ARGV.include?("--reset")
  sync_cmd = "SyncClearUrlsJob.perform_now if #{should_sync} || Setting.get('automated_rules').blank?"
  system! "bin/rails runner \"#{sync_cmd}\""
  
  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  if ENV["RAILS_ENV"] == "production" || ARGV.include?("--precompile")
    puts "\n== Precompiling assets =="
    system! "bin/rails assets:precompile"
  end

  unless ARGV.include?("--skip-server")
    # No Debian do mestre, lsof pode não estar no PATH ou exigir sudo para ver processos de outros.
    # Usamos uma checagem mais simples via Ruby socket ou comando 'ss'
    port_in_use = begin
      server = TCPServer.new('127.0.0.1', 3000)
      server.close
      false
    rescue Errno::EADDRINUSE
      true
    end

    if port_in_use || ENV["RAILS_ENV"] == "production"
      puts "\n[! NOTE] Ambiente de produção detectado ou porta ocupada. Pulando inicialização automática."
      puts "[!] O GoiabookLM deve ser gerenciado via 'systemctl' em produção. Vida que segue!"
    else
      puts "\n== Starting development server =="
      STDOUT.flush
      exec "bin/dev"
    end
  end
end
